# file-3peers: 1 scheduler (no manager) + 1 super seed peer + 3 peers,
# dfget file downloads from an nginx origin.
# Values can be overridden per run with `--set KEY=VALUE`.

# Fixture files (deterministic, sha256-verified). Small files keep Mac runs short.
DFPERF_FILE_SIZES=4MiB,64MiB
DFPERF_FIXTURE_SEED=dfperf-v1
# Measured samples per cache state, per file, per block.
DFPERF_SAMPLES=3
DFPERF_STATES=cold,seed-warm,peer-warm,local-hit
# Blocks per variant for `run` (ABBA interleaved) and for `smoke`.
DFPERF_BLOCKS=4
DFPERF_SMOKE_BLOCKS=1
# Required valid blocks per variant (compare.yaml min_blocks if unset).
DFPERF_MIN_BLOCKS=4
# `always` is required: dfget's default `auto` fetches small files directly
# from the source and would bypass the seed peer.
DFPERF_SCHEDULING_POLICY=always
DFPERF_DOWNLOAD_TIMEOUT=600
DFPERF_WARMUP_TIMEOUT=45
DFPERF_UP_TIMEOUT=180
# Fixed /24 for the block network; preflight fails on overlap.
DFPERF_NET_PREFIX=10.213.0
DFPERF_MIN_FREE_GIB=5
# Support images (resolved to digests and recorded in run.json).
DFPERF_ORIGIN_IMAGE=nginx:stable-alpine
DFPERF_TOOLS_BASE_IMAGE=alpine:3.20
