{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d7y-ci-infra.local/schemas/block.schema.json",
  "title": "dfperf block (results/<run>/blocks/<id>/block.json)",
  "type": "object",
  "required": ["schema", "run", "id", "project", "variant", "index", "order", "status", "checks", "samples", "failures", "runner_exit_code"],
  "properties": {
    "schema": {"type": "string", "enum": ["dfperf/v1"]},
    "run": {"type": "string"},
    "id": {"type": "string"},
    "project": {"type": "string", "pattern": "^dfperf-[0-9a-z]{8,}-(baseline|candidate)-b[0-9]+$"},
    "variant": {"type": "string", "enum": ["baseline", "candidate"]},
    "index": {"type": "integer"},
    "order": {"type": "integer"},
    "status": {"type": "string", "enum": ["ok", "invalid", "failed", "infra-error"]},
    "reasons": {"type": ["array", "null"], "items": {"type": "string"}},
    "checks": {"type": ["array", "null"], "items": {"$ref": "#/$defs/check"}},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "samples": {"type": "integer"},
    "failures": {"type": "integer"},
    "up_seconds": {"type": "number"},
    "runner_seconds": {"type": "number"},
    "cleanup_seconds": {"type": "number"},
    "runner_exit_code": {"type": "integer"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "ok", "required", "detail"],
      "properties": {"name": {"type": "string"}, "ok": {"type": "boolean"}, "required": {"type": "boolean"}, "detail": {"type": "string"}}
    }
  }
}
