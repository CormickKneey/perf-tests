{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d7y-ci-infra.local/schemas/run.schema.json",
  "title": "dfperf run (results/<run>/run.json)",
  "type": "object",
  "required": ["schema", "id", "mode", "profile", "baseline", "host", "non_baseline", "block_order", "fixtures", "status", "exit_code", "verdict", "started_at", "support_images"],
  "properties": {
    "schema": {"type": "string", "enum": ["dfperf/v1"]},
    "id": {"type": "string", "pattern": "^[0-9a-z]{8,}$"},
    "mode": {"type": "string", "enum": ["smoke", "compare"]},
    "profile": {"type": "string"},
    "params": {"type": "object"},
    "baseline": {"$ref": "#/$defs/variant"},
    "candidate": {"$ref": "#/$defs/variant"},
    "support_images": {"type": ["array", "null"], "items": {"$ref": "#/$defs/image"}},
    "host": {
      "type": "object",
      "required": ["os", "arch", "docker_version", "compose_version", "docker_os", "classification", "baseline_eligible"],
      "properties": {
        "hostname": {"type": "string"},
        "os": {"type": "string"},
        "kernel": {"type": "string"},
        "arch": {"type": "string"},
        "cpus": {"type": "integer"},
        "memory_bytes": {"type": "integer"},
        "docker_version": {"type": "string"},
        "compose_version": {"type": "string"},
        "docker_os": {"type": "string"},
        "docker_kernel": {"type": "string"},
        "classification": {"type": "string", "enum": ["linux-native", "docker-desktop", "orbstack", "vm-backed"]},
        "baseline_eligible": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "non_baseline": {"type": "boolean"},
    "block_order": {"type": ["array", "null"], "items": {"type": "string", "pattern": "^[0-9]{2}-(baseline|candidate)-b[0-9]+$"}},
    "fixtures": {
      "type": "object",
      "required": ["volume", "spec_hash", "files"],
      "properties": {
        "volume": {"type": "string"},
        "spec_hash": {"type": "string"},
        "seed": {"type": "string"},
        "generator": {"type": "string"},
        "files": {"type": ["array", "null"], "items": {"type": "object", "required": ["name", "size", "sha256"], "properties": {"name": {"type": "string"}, "size": {"type": "integer"}, "sha256": {"type": "string"}}}}
      }
    },
    "git_commit": {"type": "string"},
    "git_dirty": {"type": "boolean"},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "status": {"type": "string", "enum": ["running", "finished"]},
    "exit_code": {"type": "integer", "enum": [0, 1, 2, 3, 4]},
    "verdict": {"type": "string"},
    "notes": {"type": ["array", "null"], "items": {"type": "string"}}
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["component", "ref", "pinned", "image_id", "platform", "source"],
      "properties": {
        "component": {"type": "string"},
        "ref": {"type": "string"},
        "pinned": {"type": "string"},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "repo_digests": {"type": ["array", "null"], "items": {"type": "string"}},
        "registry_digest": {"type": "string"},
        "platform": {"type": "string"},
        "version": {"type": "string"},
        "source": {"type": "string", "enum": ["local", "docker-pull", "crane-load", "derived"]}
      }
    },
    "variant": {
      "type": "object",
      "required": ["name", "scheduler", "client", "driver"],
      "properties": {
        "name": {"type": "string", "enum": ["baseline", "candidate"]},
        "scheduler": {"$ref": "#/$defs/image"},
        "client": {"$ref": "#/$defs/image"},
        "driver": {"$ref": "#/$defs/image"},
        "overlays": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    }
  }
}
